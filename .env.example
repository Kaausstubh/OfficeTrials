# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://advocate_user:advocate_pass@localhost:5432/advocate_desk?schema=public"
# For SQLite local fallback development if PostgreSQL socket is unavailable:
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="advocate-case-desk-super-secure-production-jwt-secret-key-32chars"
JWT_EXPIRES_IN="7d"

# Document Storage (Local or S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/documents
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_BUCKET=advocate-case-desk-docs
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-south-1

# Redis / BullMQ (Optional for background processing)
REDIS_URL="redis://localhost:6379"
USE_REDIS_QUEUE=false

# OCR Configuration
OCR_ENGINE=tesseract
OCR_DEFAULT_LANGUAGES=eng+hin+mar

# AI Provider Configuration (Optional - Fallback rule-based search engine provided)
AI_PROVIDER=fallback
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
